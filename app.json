{
  "expo": {
    "name": "Dasta",
    "slug": "DastaNew",
    "version": "1.2.0",
    "scheme": "dastasipsense",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "updates": {
      "url": "https://u.expo.dev/84b432c9-cb11-44a1-a96d-a906ef6f75c7"
    },
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a1a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.dasta.sipsense",
      "associatedDomains": ["applinks:api.dastacafe.com"],
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "NSLocationWhenInUseUsageDescription": "Used to find the nearest Dasta café and get directions.",
        "NSFaceIDUsageDescription": "Used to quickly unlock the app instead of typing a code every time.",
        "NSPhotoLibraryUsageDescription": "Dasta never asks for access to your photos. iOS requires this description because a standard system component included in the app can work with photos.",
        "UIBackgroundModes": [
          "remote-notification"
        ]
      }
    },
    "extra": {
      "eas": {
        "projectId": "84b432c9-cb11-44a1-a96d-a906ef6f75c7"
      }
    },
    "android": {
      "package": "com.dasta.sipsense",
      "softwareKeyboardLayoutMode": "resize",
      "googleServicesFile": "./google-services.json",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#E26A2C"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "data": [{ "scheme": "dastasipsense" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "api.dastacafe.com",
              "pathPrefix": "/dasta-circle"
            }
          ],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.SYSTEM_ALERT_WINDOW"
      ]
    },
    "plugins": [
      "expo-web-browser",
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#E26A2C"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Used to find the nearest Dasta café and get directions.",
          "locationAlwaysAndWhenInUsePermission": false,
          "locationAlwaysPermission": false
        }
      ],
      "expo-secure-store",
      [
        "@stripe/stripe-react-native",
        {
          "merchantIdentifier": "merchant.com.dasta.sipsense",
          "enableGooglePay": true
        }
      ],
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Used so you can speak your drink order instead of typing it."
        }
      ],
      "expo-asset",
      [
        "expo-camera",
        {
          "cameraPermission": "Used to scan a friend's Dasta Account ID QR code to add them to your Circle.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Used so you can speak your drink order instead of typing it.",
          "speechRecognitionPermission": "Used to turn your spoken drink order into text instantly."
        }
      ]
    ]
  }
}
